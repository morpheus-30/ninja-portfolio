# GitHub OAuth App credentials (for admin login)
# Create one at: https://github.com/settings/developers
# Set the Authorization callback URL to: https://iamnaksh.tech/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Secret used to sign session JWT tokens (generate a random 32+ character string)
# Example: openssl rand -hex 32
SESSION_SECRET=

# Your production domain (with protocol). Set this in Vercel Environment Variables.
# This MUST match the domain registered in your GitHub OAuth App.
SITE_URL=https://iamnaksh.tech

# GitHub Personal Access Token for publishing portfolio content.
# Create at: https://github.com/settings/tokens
# Required scope: "repo" (or fine-grained token with Contents read/write on ninja-portfolio)
# This token is used server-side only to commit content updates.
GITHUB_PAT=
